# Phase 2용 설정 명세. 아직 FastAPI 애플리케이션은 구현되지 않았습니다.
DATABASE_URL=postgresql://USER:PASSWORD@SUPABASE_POOLER_HOST:PORT/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase SDK 사용 시에만 필요. 프론트엔드에는 절대 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_SERVER_ONLY
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
# FastAPI CORSMiddleware에는 JSON 배열을 파싱해서 전달할 예정입니다.
# 프로덕션은 실제로 배포한 HTTPS origin만 허용합니다.
CORS_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
