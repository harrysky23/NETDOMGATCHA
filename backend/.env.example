# Supabase Connect → Session pooler.비밀번호 특수 문자는 URL 인코딩합니다.
# 실제 연결 문자열은 서버에만 저장하고 커밋/채팅에 노출하지 않습니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Docker 통합 배포는 동일 출처이므로 외부 CORS 허용이 필요하지 않습니다.
CORS_ORIGINS=[]
# 프론트를 별도 도메인에 배포할 때만 실제 HTTPS origin으로 변경합니다.
# CORS_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
